{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "dxcoder-plugin-fixora",
  "version": "0.2.0",
  "description": "Turn production crashes (Sentry, Firebase Crashlytics, pasted stack traces) into reviewed, tested draft merge requests using the DXcoder coding agent",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts",
    "./tui": "./tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "src",
    "skills",
    "script"
  ],
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "build": "bun run script/build.ts",
    "pack": "bun run script/build.ts --pack"
  },
  "dependencies": {
    "gray-matter": "4.0.3"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.29",
    "effect": "^4.0.0",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": { "optional": true },
    "@opentui/solid": { "optional": true },
    "solid-js": { "optional": true }
  }
}
